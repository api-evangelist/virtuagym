  "items": [
    {
      "info": { "name": "Club Members", "type": "folder" },
      "items": [
        {
          "info": { "name": "List club members.", "type": "http" },
          "http": {
            "method": "GET",
            "url": "https://api.virtuagym.com/api/v1/club/:club_id/member?api_key=&club_secret=&sync_from=0",
            "params": [
              { "name": "club_id", "value": "", "type": "path", "description": "The Virtuagym club ID." },
              { "name": "api_key", "value": "", "type": "query", "description": "Club API key." },
              { "name": "club_secret", "value": "", "type": "query", "description": "Club secret." },
              { "name": "sync_from", "value": "0", "type": "query", "description": "Unix timestamp in milliseconds; return records edited since." }
            ]
          },
          "docs": "Returns members of the club edited since sync_from. Supports from_id, email, external_id, rfid_tag, club_member_id, with, any_sub_club."
        },
        {
          "info": { "name": "Create a club member.", "type": "http" },
          "http": {
            "method": "PUT",
            "url": "https://api.virtuagym.com/api/v1/club/:club_id/member?api_key=&club_secret=",
            "params": [
              { "name": "club_id", "value": "", "type": "path", "description": "The Virtuagym club ID." },
              { "name": "api_key", "value": "", "type": "query", "description": "Club API key." },
              { "name": "club_secret", "value": "", "type": "query", "description": "Club secret." }
            ],
            "body": { "type": "json", "data": "{\n  \"firstname\": \"Jane\",\n  \"lastname\": \"Doe\",\n  \"email\": \"jane@example.com\",\n  \"external_id\": \"ext-123\"\n}" }
          },
          "docs": "Creates a new member in the club."
        },
        {
          "info": { "name": "Retrieve a club member.", "type": "http" },
          "http": {
            "method": "GET",
            "url": "https://api.virtuagym.com/api/v1/club/:club_id/member/:member_id?api_key=&club_secret=",
            "params": [
              { "name": "club_id", "value": "", "type": "path", "description": "The Virtuagym club ID." },
              { "name": "member_id", "value": "", "type": "path", "description": "Internal Virtuagym club member ID." },
              { "name": "api_key", "value": "", "type": "query", "description": "Club API key." },
              { "name": "club_secret", "value": "", "type": "query", "description": "Club secret." }
            ]
          },
          "docs": "Returns the details of a specific member by internal Virtuagym ID."
        },
        {
          "info": { "name": "Update a club member.", "type": "http" },
          "http": {
            "method": "PUT",
            "url": "https://api.virtuagym.com/api/v1/club/:club_id/member/:member_id?api_key=&club_secret=",
            "params": [
              { "name": "club_id", "value": "", "type": "path", "description": "The Virtuagym club ID." },
              { "name": "member_id", "value": "", "type": "path", "description": "Internal Virtuagym club member ID." },
              { "name": "api_key", "value": "", "type": "query", "description": "Club API key." },
              { "name": "club_secret", "value": "", "type": "query", "description": "Club secret." }
            ],
            "body": { "type": "json", "data": "{}" }
          },
          "docs": "Updates an existing member identified by internal Virtuagym ID."
        },
        {
          "info": { "name": "Create or update a member by external ID.", "type": "http" },
          "http": {
            "method": "PUT",
            "url": "https://api.virtuagym.com/api/v1/club/:club_id/member/create_or_update?api_key=&club_secret=",
            "params": [
              { "name": "club_id", "value": "", "type": "path", "description": "The Virtuagym club ID." },
              { "name": "api_key", "value": "", "type": "query", "description": "Club API key." },
              { "name": "club_secret", "value": "", "type": "query", "description": "Club secret." }
            ],
            "body": { "type": "json", "data": "{\n  \"external_id\": \"ext-123\",\n  \"firstname\": \"Jane\",\n  \"lastname\": \"Doe\"\n}" }
          },
          "docs": "Creates or updates a member matched on external_id."
        },
        {
          "info": { "name": "Activate a member's user profile.", "type": "http" },
          "http": {
            "method": "POST",
            "url": "https://api.virtuagym.com/api/v1/club/:club_id/member/activate_user?api_key=&club_secret=",
            "params": [
              { "name": "club_id", "value": "", "type": "path", "description": "The Virtuagym club ID." },
              { "name": "api_key", "value": "", "type": "query", "description": "Club API key." },
              { "name": "club_secret", "value": "", "type": "query", "description": "Club secret." }
            ],
            "body": { "type": "json", "data": "{}" }
          },
          "docs": "Activates or connects a member's Virtuagym user profile."
        }
      ]
    },
