    { "key": "baseUrl", "value": "https://api.virtuagym.com/api", "type": "string" },
    { "key": "apiKey", "value": "", "type": "string" },
    { "key": "clubSecret", "value": "", "type": "string" },
    { "key": "clubId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Club Members",
      "item": [
        {
          "name": "List club members",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/v1/club/{{clubId}}/member?api_key={{apiKey}}&club_secret={{clubSecret}}&sync_from=0", "host": ["{{baseUrl}}"], "path": ["v1", "club", "{{clubId}}", "member"], "query": [{ "key": "api_key", "value": "{{apiKey}}" }, { "key": "club_secret", "value": "{{clubSecret}}" }, { "key": "sync_from", "value": "0" }] },
            "description": "Returns members of the club edited since sync_from (ms). Supports from_id, email, external_id, rfid_tag, club_member_id, with, any_sub_club."
          }
        },
        {
          "name": "Create a club member",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"firstname\": \"Jane\",\n  \"lastname\": \"Doe\",\n  \"email\": \"jane@example.com\",\n  \"external_id\": \"ext-123\"\n}" },
            "url": { "raw": "{{baseUrl}}/v1/club/{{clubId}}/member?api_key={{apiKey}}&club_secret={{clubSecret}}", "host": ["{{baseUrl}}"], "path": ["v1", "club", "{{clubId}}", "member"], "query": [{ "key": "api_key", "value": "{{apiKey}}" }, { "key": "club_secret", "value": "{{clubSecret}}" }] },
            "description": "Creates a new member in the club."
          }
        },
        {
          "name": "Retrieve a club member",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/v1/club/{{clubId}}/member/:member_id?api_key={{apiKey}}&club_secret={{clubSecret}}", "host": ["{{baseUrl}}"], "path": ["v1", "club", "{{clubId}}", "member", ":member_id"], "query": [{ "key": "api_key", "value": "{{apiKey}}" }, { "key": "club_secret", "value": "{{clubSecret}}" }], "variable": [{ "key": "member_id", "value": "" }] },
            "description": "Returns the details of a specific member by internal Virtuagym ID."
          }
        },
        {
          "name": "Update a club member",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": { "raw": "{{baseUrl}}/v1/club/{{clubId}}/member/:member_id?api_key={{apiKey}}&club_secret={{clubSecret}}", "host": ["{{baseUrl}}"], "path": ["v1", "club", "{{clubId}}", "member", ":member_id"], "query": [{ "key": "api_key", "value": "{{apiKey}}" }, { "key": "club_secret", "value": "{{clubSecret}}" }], "variable": [{ "key": "member_id", "value": "" }] },
            "description": "Updates an existing member identified by internal Virtuagym ID."
          }
        },
        {
          "name": "Create or update a member by external ID",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"external_id\": \"ext-123\",\n  \"firstname\": \"Jane\",\n  \"lastname\": \"Doe\"\n}" },
            "url": { "raw": "{{baseUrl}}/v1/club/{{clubId}}/member/create_or_update?api_key={{apiKey}}&club_secret={{clubSecret}}", "host": ["{{baseUrl}}"], "path": ["v1", "club", "{{clubId}}", "member", "create_or_update"], "query": [{ "key": "api_key", "value": "{{apiKey}}" }, { "key": "club_secret", "value": "{{clubSecret}}" }] },
            "description": "Creates or updates a member matched on external_id."
          }
        },
        {
          "name": "Activate a member's user profile",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": { "raw": "{{baseUrl}}/v1/club/{{clubId}}/member/activate_user?api_key={{apiKey}}&club_secret={{clubSecret}}", "host": ["{{baseUrl}}"], "path": ["v1", "club", "{{clubId}}", "member", "activate_user"], "query": [{ "key": "api_key", "value": "{{apiKey}}" }, { "key": "club_secret", "value": "{{clubSecret}}" }] },
            "description": "Activates or connects a member's Virtuagym user profile."
          }
        }
      ]
    },
